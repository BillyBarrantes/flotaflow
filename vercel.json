{
  "buildCommand": "cd console && ./node_modules/.bin/ember build --environment=production",
  "outputDirectory": "console/dist",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "cleanUrls": false,
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
